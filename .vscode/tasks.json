{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Generate JSDocs in Wiki",
			"type": "shell",
			"command": "jsdoc --destination wiki/docs --readme README.md ${input:jsdocFiles}",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "jsdocFiles",
			"description": "Space-separated list of files to include in the JSDoc generation",
			"default": "*.js",
			"type": "promptString"
		}
	]
}
