{
  "compilerOptions": {
    // Emit modern JavaScript syntax.
    "target": "ES2022",

    // Let the bundler (tsup/esbuild) handle modules.
    "module": "ESNext",

    // Expose modern APIs and browsers' DOMs to TypeScript.
    "lib": ["ES2022", "DOM"],

    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    
    "rootDir": "src",
    "outDir": "dist",
    
    "types": [],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dev.html"],
}
