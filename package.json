{
  "name": "dialog-box",
  "version": "0.3.0",
  "description": "Dialog Box web component with external CSS and dev cache-busting.",
  "type": "module",
  "keywords": [
    "web components",
    "custom elements",
    "dialog",
    "shadow dom",
    "ui"
  ],
  "author": "Andy Harrison",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizard04wsu/dialog-box.git"
  },
  "bugs": {
    "url": "https://github.com/wizard04wsu/dialog-box/issues"
  },
  "homepage": "https://github.com/wizard04wsu/dialog-box#readme",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dialog-box": {
      "import": "./dist/dialog-box.js",
      "types": "./dist/dialog-box.d.ts",
      "default": "./dist/dialog-box.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:tsup": "cross-env tsup",
    "build:jsdoc": "jsdoc --destination wiki/docs --readme README.md dist",
    "build:all": "run-s build:tsup build:jsdoc",
    "kill:port": "kill-port 5174",
    "serve:http": "http-server -c-1 -p 5174 .",
    "dev:serve": "run-s kill:port serve:http"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.4",
    "kill-port": "^2.0.1",
    "npm-run-all": "^4.1.5",
    "shx": "^0.3.4",
    "tsup": "^8.0.1",
    "typescript": "^5.5.4"
  }
}
