{
  "name": "@example/dialog-box",
  "version": "0.3.0",
  "description": "Dialog Box web component with external CSS and dev cache-busting.",
  "type": "module",
  "keywords": [
    "web components",
    "custom elements",
    "dialog",
    "shadow dom",
    "ui"
  ],
  "author": "Andy Harrison",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizard04wsu/dialog-box.git"
  },
  "bugs": {
    "url": "https://github.com/wizard04wsu/dialog-box/issues"
  },
  "homepage": "https://github.com/wizard04wsu/dialog-box#readme",
  "exports": {
    ".": {
      "import": "./dist/dialog-box.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/dialog-box.js"
    },
    "./define": {
      "import": "./dist/define.js",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/define.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "shx rm -rf dist && rm -rf wiki/docs",
    "copy:css": "shx mkdir -p dist && cp src/dialog-box.css dist/",
    "dev:build:only": "cross-env NODE_ENV=development tsup --sourcemap",
    "dev:build:watch": "cross-env NODE_ENV=development tsup --sourcemap --watch",
    "build:jsdoc": "jsdoc --destination wiki/docs --readme README.md dist",
    "dev:build": "run-s clean copy:css dev:build:only build:jsdoc",
    "dev:watch": "run-s dev:build dev:build:watch",
    "watch:css": "chokidar \"src/dialog-box.css\" -c \"npm run copy:css\"",
    "dev:serve": "http-server -c-1 -p 5174 .",
    "dev:live": "run-s dev:build && run-p dev:build:watch watch:css dev:serve",
    "prod:build:only": "cross-env NODE_ENV=production tsup",
    "prod:build": "run-s clean copy:css prod:build:only build:jsdoc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "shx": "^0.3.4",
    "tsup": "^8.0.1",
    "typescript": "^5.5.4"
  }
}
